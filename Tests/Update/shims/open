#!/bin/bash
# Stand-in for /usr/bin/open: "launches" Hammer.app by writing its version to
# $FAKE/running and, like the real Hammer once it has started, ~/Hammer/.launched.
# Like LaunchServices, opening an app that's already running just brings it forward.
# FAKE_KILL_AT_OPEN=KILL: the update is killed just before the new app opens.
# FAKE_CRASH_LATER_VERSION: that version starts (writes .launched), then crashes a few seconds in.
# FAKE_QUIT_LATER_VERSION: the same, but you quit it (it writes .quit, as Quit Hammer does).
source "$(dirname "$0")/_log"
app="$1"
v="$(cat "$app/Contents/Resources/VERSION" 2>/dev/null || echo '?')"
args=""; [[ " $* " == *" --login "* ]] && args=" --login"
if [ ! -d "$app" ]; then echo "The file $app does not exist." >&2; log "open FAILED (no app)$args"; exit 1; fi
if [ -n "${FAKE_OPEN_FAIL_VERSION:-}" ] && [ "$v" = "$FAKE_OPEN_FAIL_VERSION" ]; then
  echo "The application cannot be opened for an unexpected reason, error=Error Domain=NSOSStatusErrorDomain Code=-10669" >&2
  log "open FAILED ($v)$args"; exit 1
fi
if [ -n "${FAKE_KILL_AT_OPEN:-}" ] && [ ! -e "$FAKE/killed" ]; then   # stopped just before the new app opens
  : > "$FAKE/killed"
  log "SIG$FAKE_KILL_AT_OPEN to the whole update, just before opening $v"
  kill -s "$FAKE_KILL_AT_OPEN" -- "-$(ps -o pgid= -p $$ | tr -d ' ')"
  perl -e 'select(undef, undef, undef, 2)'
fi
if [ -f "$FAKE/running" ]; then log "open: brought the running Hammer $(cat "$FAKE/running") forward$args"; exit 0; fi
if [ -n "${FAKE_CRASH_VERSION:-}" ] && [ "$v" = "$FAKE_CRASH_VERSION" ]; then log "open OK ($v)$args, then it crashed"; exit 0; fi
echo "$v" > "$FAKE/running"
mkdir -p "$HOME/Hammer" && printf '%s\n%s\n' "$v" 4242 > "$HOME/Hammer/.launched"
if [ -n "${FAKE_QUIT_LATER_VERSION:-}" ] && [ "$v" = "$FAKE_QUIT_LATER_VERSION" ]; then
  echo 3 > "$FAKE/crash-after"
  printf '%s\n' "$v" > "$HOME/Hammer/.quit"
  log "open OK ($v)$args, it started, then you quit it"
  exit 0
fi
if [ -n "${FAKE_CRASH_LATER_VERSION:-}" ] && [ "$v" = "$FAKE_CRASH_LATER_VERSION" ]; then
  echo 3 > "$FAKE/crash-after"        # pgrep sees it 3 more times, then it's gone
  log "open OK ($v)$args, it started, then it crashed a few seconds in"
  exit 0
fi
log "open OK ($v)$args"
