#!/bin/bash
# Stand-in for swiftc: "builds" a test binary or a Hammer binary (a small script).
#   FAKE_SWIFTC_FAIL=1   the compile fails       FAKE_TESTS_EXIT=n    the tests exit with n
#   FAKE_TESTS_HANG=1    the tests never finish   FAKE_ICON_FAIL=1     make-icon fails
#   FAKE_SWIFTC_HOOK     a command run first (e.g. a second updater starting meanwhile)
source "$(dirname "$0")/_log"
out=""; target=""; flags=""
while [ $# -gt 0 ]; do
  case "$1" in -o) out="$2"; shift;; -target) target="$2"; shift;; -swift-version) flags="$flags swift$2"; shift;; esac
  shift
done
log "swiftc -> ${out##*/} ($target$flags)"
if [ -n "${FAKE_SWIFTC_HOOK:-}" ]; then (hook="$FAKE_SWIFTC_HOOK"; unset FAKE_SWIFTC_HOOK; eval "$hook"); fi
if [ "${FAKE_SWIFTC_FAIL:-0}" = 1 ]; then echo "error: No space left on device" >&2; exit 1; fi
case "$out" in
  *hammer-tests)
    cat > "$out" <<'BIN'
#!/bin/bash
[ "${FAKE_TESTS_HANG:-0}" = 1 ] && exec perl -e 'select(undef, undef, undef, 30)'
echo "tests: all passed"; exit "${FAKE_TESTS_EXIT:-0}"
BIN
    ;;
  *)
    cat > "$out" <<'BIN'
#!/bin/bash
# a stand-in Hammer binary
if [ "$1" = make-icon ]; then
  [ "${FAKE_ICON_FAIL:-0}" = 1 ] && exit 1
  mkdir -p "$2" && for s in 16 32 128 256 512; do echo png > "$2/icon_${s}x${s}.png"; echo png > "$2/icon_${s}x${s}@2x.png"; done
fi
BIN
    ;;
esac
chmod +x "$out"
